    "verify:voice": "tsx scripts/verify-voice.ts",
    "decoders": "tsx scripts/decoders.ts",
    "ask": "tsx scripts/ask.ts",
    "rehearse": "tsx scripts/rehearse.ts",
    "reexplain": "tsx scripts/reexplain.ts",
    "verify:batch": "tsx scripts/verify-batch.ts",
    "verify:media": "tsx scripts/verify-media.ts",
    "verify:edge": "tsx scripts/verify-edge.ts",
    "verify:preview": "tsx scripts/verify-preview.ts"
