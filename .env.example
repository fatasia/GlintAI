# Optional server-side model configuration. Never commit real credentials.
GLINT_LLM_API_KEY=
GLINT_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLINT_LLM_MODEL=glm-4
# Optional, only for models supporting this parameter (GLM-5.3-Flash accepts low/high/max).
GLINT_LLM_REASONING_EFFORT=
GLINT_LLM_PROTOCOL=auto
GLINT_VERSION=0.1.0
PORT=4175
GLINT_RENDER_CONCURRENCY=4

# Optional local voice clone (paths stay on the server; weights are not bundled).
GLINT_QWEN_PYTHON=python
GLINT_QWEN_MODEL=
GLINT_QWEN_REFERENCE=
GLINT_QWEN_REFERENCE_TEXT=

# Optional cloud speech engines. Never reuse an LLM key for these services.
GLINT_TTS_BASE_URL=https://api.openai.com/v1
GLINT_TTS_API_KEY=
GLINT_TTS_MODEL=gpt-4o-mini-tts
GLINT_TTS_VOICE=alloy
GLINT_ELEVENLABS_API_KEY=
GLINT_ELEVENLABS_VOICE=
GLINT_ELEVENLABS_MODEL=eleven_multilingual_v2
GLINT_FISH_API_KEY=
GLINT_FISH_VOICE=
GLINT_FISH_MODEL=s2.1-pro

# Official MiniMax account (not a gateway key).
GLINT_MINIMAX_BASE_URL=https://api.minimax.io/v1
GLINT_MINIMAX_API_KEY=
GLINT_MINIMAX_VOICE=
GLINT_MINIMAX_TTS_MODEL=speech-2.8-hd
GLINT_MINIMAX_MUSIC_MODEL=music-3.0
GLINT_MUSIC_PROMPT=

# Async media gateway: Suno, MiniMax, images, short video and hosted TTS.
GLINT_MEDIA_BASE_URL=
GLINT_MEDIA_API_KEY=
GLINT_MEDIA_TTS_MODEL=gem-3.1-tts
GLINT_MEDIA_TTS_VOICE=Zephyr
GLINT_MEDIA_TTS_PARAMS=
# Opt-in public DNS for TUN/Fake-IP networks; public-address checks remain enabled.
GLINT_MEDIA_PUBLIC_DNS=0
GLINT_MEDIA_MUSIC_MODEL=suno-v6
GLINT_MEDIA_MUSIC_PARAMS={"make_instrumental":"instrumental","mv":"v6-mini"}

# Network deployment requires an exact hostname and a random 24+ character token.
GLINT_PUBLIC_HOST=
GLINT_ACCESS_TOKEN=
