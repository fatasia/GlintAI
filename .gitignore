# Dependencies
node_modules/

# Builds
dist/
build/
# Authored Vite plugin, not generated build output.
!apps/web/build/
apps/web/build/*
!apps/web/build/frozen-prototype.mjs
apps/desktop/target/
apps/desktop/secure-assets/target/
*.tsbuildinfo
quality-report.json*
__pycache__/

# Local build manifests (per project, machine state)
.glint/

# Render outputs and generated runtime assets (narration audio, copied figures)
out/
.cache/
apps/studio/public/

# Environment / secrets
.env
.env.*
!.env.example

# Editor & OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
dist-portable/
apps/studio/.media-settings.json


# Working notes, benchmarks and local evidence artifacts (not part of the repo)
HANDOFF.md
outputs/
dist-portable/
.smoke-data/
.tmp-*
*.local.md

# Local verification evidence stays out of the published tree
/evidence/

# Agent tool mirrors and locally installed skills; only the bundled skill is tracked
/.agents/
/.claude/
/skills/*
!/skills/glint-video/
