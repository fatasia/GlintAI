      "html": "<div id=\"glint-root\" style=\"height:100%;width:100%\"></div><script>window.__glintLottie={\"v\":\"5.13.0\",\"fr\":24,\"ip\":0,\"op\":12,\"w\":800,\"h\":500,\"nm\":\"Glint own rectangle\",\"ddd\":0,\"assets\":[],\"layers\":[{\"ddd\":0,\"ind\":1,\"ty\":4,\"nm\":\"Rectangle\",\"sr\":1,\"ks\":{\"o\":{\"a\":0,\"k\":100},\"r\":{\"a\":0,\"k\":0},\"p\":{\"a\":1,\"k\":[{\"t\":0,\"s\":[260,250,0],\"e\":[540,250,0],\"i\":{\"x\":[1,1,1],\"y\":[1,1,1]},\"o\":{\"x\":[0,0,0],\"y\":[0,0,0]}},{\"t\":12,\"s\":[540,250,0]}]},\"a\":{\"a\":0,\"k\":[0,0,0]},\"s\":{\"a\":0,\"k\":[100,100,100]}},\"ao\":0,\"shapes\":[{\"ty\":\"rc\",\"d\":1,\"s\":{\"a\":0,\"k\":[220,180]},\"p\":{\"a\":0,\"k\":[0,0]},\"r\":{\"a\":0,\"k\":20},\"nm\":\"Shape\"},{\"ty\":\"fl\",\"c\":{\"a\":0,\"k\":[0.4,0.7,1,1]},\"o\":{\"a\":0,\"k\":100},\"r\":1,\"nm\":\"Fill\"}],\"ip\":0,\"op\":12,\"st\":0,\"bm\":0}]};</script>",
